# ==============================
# Dig'em Aggies Website Routing
# ==============================

# Serve index.html by default
DirectoryIndex index.html

# Enable URL rewriting
RewriteEngine On
RewriteBase /


# --------------------------------
# Force HTTPS and remove www
# --------------------------------
# Redirect all HTTP and www traffic to https://digemaggies.org
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://digemaggies.org%{REQUEST_URI} [L,R=301,NE]


# --------------------------------
# Canonicalize direct file URLs to clean paths
# --------------------------------
# Example: /pages/sponsorpage/sponsorindex.html -> /sponsor
RewriteRule ^pages/aboutpage/aboutindex\.html$ /about [R=301,L,NE]
RewriteRule ^pages/contactpage/contactindex\.html$ /contact [R=301,L,NE]
RewriteRule ^pages/sponsorpage/sponsorindex\.html$ /sponsor [R=301,L,NE]
RewriteRule ^pages/(about|contact|sponsor)page/?$ /$1 [R=301,L,NE]


# --------------------------------
# Skip rewriting for assets and media
# --------------------------------
RewriteCond %{REQUEST_URI} ^/assets/ [NC,OR]
RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|webp|svg|css|js|ico|woff|woff2|ttf|eot|mp4|mov|pdf)$ [NC]
RewriteRule ^ - [L]


# --------------------------------
# Skip existing files and directories
# --------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# --------------------------------
# Clean URL routes
# --------------------------------
RewriteRule ^about/?$ /pages/aboutpage/aboutindex.html [L]
RewriteRule ^contact/?$ /pages/contactpage/contactindex.html [L]
RewriteRule ^sponsor/?$ /pages/sponsorpage/sponsorindex.html [L]


# Optional trailing slash or legacy alias support
RewriteRule ^sponsors/?$ /sponsor [R=301,L]


# --------------------------------
# Default route for home page
# --------------------------------
RewriteRule ^/?$ /index.html [L]


# --------------------------------
# SPA-like 404 fallback
# --------------------------------
ErrorDocument 404 /index.html